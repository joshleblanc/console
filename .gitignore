# publish-cart output: cart-staging/ plus one directory, .bin and .zip per
# published cart. Regenerated by ./publish-cart <cart>.
builds/

# The site's publishing credentials, unpacked from a personal download. It holds
# a live API key, so it must never be committed -- and neither must the ZIPs
# ./publish-site --dry-run leaves in builds/ (that directory is already ignored,
# and this says so where someone adding the next one will look).
dragonstation.json

