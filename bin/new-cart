#!/bin/sh
# Scaffold a new cart: create carts/<name>/ with an app/main.rb skeleton and
# the asset directories the console looks for, then make it its own git repo
# with an initial commit -- carts/ is yours to version separately.
#
#   ./new-cart <name>
#   ./new-cart --no-git <name>   skip the repo
#
# The name becomes the cart directory and -- run through the same camel-case
# rule Console::Str.camel applies -- the class the entry file defines, so it
# must be a bare directory name: letters, digits, '-' and '_', starting with
# a letter.
#
# Exits non-zero when the name is invalid or carts/<name> already exists.
# Git trouble is only ever a warning: the cart is still created and the
# script exits zero.
cd "$(dirname "$0")/.."

die() { echo "new-cart: $*" >&2; exit 1; }
warn() { echo "new-cart: warning: $*" >&2; }

usage() {
  echo "usage: new-cart [--no-git] <name>"
  echo ""
  echo "  creates carts/<name>/ with an app/main.rb skeleton and empty"
  echo "  sprites/, sounds/, maps/ and data/ directories, then makes it a"
  echo "  git repo with an initial commit. --no-git skips the repo."
}

NO_GIT=0
NAME=""
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --no-git) NO_GIT=1 ;;
    -*) die "unknown option: $1" ;;
    *)
      [ -n "$NAME" ] && die "expected exactly one name (usage: new-cart [--no-git] <name>)"
      NAME=$1
      ;;
  esac
  shift
done

[ -z "$NAME" ] && { usage >&2; exit 1; }

printf '%s' "$NAME" | grep -Eq '^[A-Za-z][A-Za-z0-9_-]*$' \
  || die "'$NAME' is not a valid cart name (letters, digits, '-' and '_', starting with a letter)"

[ -e "carts/$NAME" ] && die "carts/$NAME already exists"

if [ -e "samples/$NAME" ]; then
  echo "new-cart: warning: carts/$NAME will shadow the '$NAME' sample in the gallery" >&2
fi

# The class the loader expects is Console::Str.camel(name): split on '-' and
# '_', uppercase the first character of each part, join. app/console/str.rb.
CLASS=$(printf '%s' "$NAME" | awk 'BEGIN { FS = "[-_]" } {
  for (i = 1; i <= NF; i++) printf "%s%s", toupper(substr($i, 1, 1)), substr($i, 2)
}')

mkdir -p "carts/$NAME/app" "carts/$NAME/sprites" "carts/$NAME/sounds" \
         "carts/$NAME/maps" "carts/$NAME/data" \
  || die "could not create carts/$NAME"

cat > "carts/$NAME/app/main.rb" <<EOF
# Cart: $NAME
#
#   ./bin/run $NAME
#
# See "The cart contract" in the console README. Every hook is optional.
TITLE = '$NAME'

class $CLASS
  # Optional: short names for assets. Anything under this cart's own sprites/
  # is already reachable by name without this.
  def self.assets
    {}
  end

  # Called once, when the console boots.
  def setup
  end

  # Called every frame, unless the cart registers scenes.
  def update
  end

  # Called every frame, always last.
  def render
    draw.text TITLE, place: { x: 0.5, y: 0.5, anchor_x: 0.5, anchor_y: 0.5 },
              size_px: 40, color: :accent
  end
end
EOF

# Each cart is its own repository: carts/ is git-ignored by the console, so a
# nested repo is the way a cart gets versioned. The ignore and attributes
# files only exist when the repo does.
GIT_DONE=0
if [ "$NO_GIT" -eq 0 ]; then
  if ! command -v git >/dev/null 2>&1; then
    warn "git not found; skipped git init"
  else
    cat > "carts/$NAME/.gitignore" <<EOF
.DS_Store
Thumbs.db
EOF
    cat > "carts/$NAME/.gitattributes" <<EOF
*.rb text eol=lf
*.md text eol=lf
*.json text eol=lf
*.ldtk text eol=lf
*.png binary
*.ogg binary
*.wav binary
*.ttf binary
EOF
    if ! git -C "carts/$NAME" init -q; then
      warn "git init failed in carts/$NAME"
    elif ! git -C "carts/$NAME" add -A ||
         ! git -C "carts/$NAME" commit -q -m "Scaffold $NAME cart"; then
      warn "repo initialized but the initial commit failed (set user.name and user.email, then commit in carts/$NAME)"
    else
      GIT_DONE=1
    fi
  fi
fi

echo "created carts/$NAME"
echo "  carts/$NAME/app/main.rb"
echo "  carts/$NAME/sprites/"
echo "  carts/$NAME/sounds/"
echo "  carts/$NAME/maps/"
echo "  carts/$NAME/data/"
if [ -f "carts/$NAME/.gitignore" ]; then
  echo "  carts/$NAME/.gitignore"
  echo "  carts/$NAME/.gitattributes"
fi
echo ""
[ "$GIT_DONE" -eq 1 ] && echo "initialized git repo with initial commit"
echo "next: ./bin/run $NAME"
exit 0
